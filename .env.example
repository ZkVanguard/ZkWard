NEXT_PUBLIC_COMMUNITY_POOL_PROXY_ADDRESS=
NEXT_PUBLIC_HEDGE_EXECUTOR_ADDRESS=
# Server-only treasury key, required only if EVM community-pool cron is live
TREASURY_PRIVATE_KEY=
