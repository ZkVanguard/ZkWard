# =============================================================================
# DISCORD ALERTING
# =============================================================================
# Webhook for all TRADE / KILL / WARN / ERROR / INFO events across trader, cron,
# and defense modules. If unset, notifyDiscord() no-ops silently — you lose
# the only out-of-band operator visibility.
DISCORD_WEBHOOK_URL=

# =============================================================================
# v0.3.0 DEFENSE SYSTEM — 8-gate autonomy defense
# =============================================================================
# All destructive actions ship behind env flags (default OFF for log-observe).
# Rollout order (see docs/MAINNET_READINESS.md § Scale & Security Hardening):
#   1. Deploy → 24h log-observe
#   2. Schedule QStash cron for alert-response-loop
#   3. Flip PORTFOLIO_DRIVER_EXECUTE=1 first (biggest gate)
#   4. Then STALE_HEDGE_AUTO_CLOSE=1
#   5. Then ALERT_RESPONSE_EXECUTE=1
#   6. Then ALERT_RESPONSE_EXECUTE_HALT=1 (most destructive, last)
# Set to 1 to enable each gate; unset or 0 = log-only.
PORTFOLIO_DRIVER_EXECUTE=
STALE_HEDGE_AUTO_CLOSE=
ALERT_RESPONSE_EXECUTE=
ALERT_RESPONSE_EXECUTE_HALT=
# Set to 1 to disable regret-tracker stake scaling in polymarket-edge-trader
REGRET_TRACKER_DISABLE=
# Set to 1 to force-disable profit-lock guard (emergency use only)
PROFIT_LOCK_DISABLE=
# Set to 1 to disable auto re-engagement after profit-lock recovery
RECOVERY_REENGAGE_DISABLE=
# Profit-lock zero-risk exit hysteresis (%). Once in zero-risk (100% USDC),
# require drawdown to recover past `PROFIT_LOCK_ZERO_RISK_AT - PROFIT_LOCK_HYSTERESIS_PCT`
# before easing. Prevents wash-trade chop when NAV oscillates around zeroAt.
# Default 5 → enter at 20% DD, exit at 15% DD.
PROFIT_LOCK_HYSTERESIS_PCT=
# Rolling-window (days) for the poolNav:peak calculation shared by both the
# HEDGE_DRAWDOWN_HALT_PCT gate (step-8-auto-hedge) and the profit-lock gate
# (step-4-nav-defense). Peak = max NAV over this window (was all-time max —
# created a chicken-and-egg halt loop after any real drawdown, since both
# gates would permanently trip vs a stale historical high). Default 7.
# Longer window = stricter drawdown protection; shorter = more responsive.
PEAK_ROLLING_WINDOW_DAYS=
# Signal-flip confidence gate (%). agent-signal-tick treats direction change
# as a real flip only when the NEW signal is ≥ this confidence. Prevents
# noise flips (39% conf coin-flips) from triggering wash-trade drift-closes.
# Default 55.
SIGNAL_FLIP_MIN_CONF=
# agent-signal-tick claim debounce (ms). Was 90s, effectively polling the
# Polymarket 5-min binary market every 2 min via QStash. Prod showed 125
# flips in the ring buffer with 48 at ≥85% conf — the 5-min binary is
# essentially a coin-flip market, using it at 2-min sample rate churns.
# Default 15 min matches the effective persistence of the underlying feed.
SIGNAL_TICK_INTERVAL_MS=
# Set to 1 to run new perp router in shadow-mode (compare, do not execute)
PERP_ROUTER_SHADOW=

# =============================================================================
# SUI RPC INFRASTRUCTURE (env-tunable per environment; sensible defaults)
# =============================================================================
# Circuit breaker: opens after N consecutive failures, waits M ms before
# probing again. Tune stricter for prod, looser for dev. Consumed by
# lib/services/sui/sui-rpc-utils.ts (suiRpcCircuitBreaker).
SUI_RPC_CIRCUIT_THRESHOLD=5
SUI_RPC_CIRCUIT_RESET_MS=30000
# Per-request RPC timeout + backoff retries. Public Sui RPC has 100 rps
# IP caps; private QuickNode/Ankr endpoints tolerate more.
SUI_RPC_TIMEOUT_MS=10000
SUI_RPC_MAX_RETRIES=2
# Dedup cache TTLs — 100 concurrent readers = 1 RPC call per TTL window.
# Lower during backfills to see fresh writes; raise to reduce RPC noise.
SUI_STATS_TTL_MS=60000
SUI_MEMBER_TTL_MS=30000
SUI_MEMBERS_TTL_MS=120000

# =============================================================================
# BLUEFIN OPEN-POSITION GUARDS
# =============================================================================
# Set to 1 to bypass the 1.5× minQty buffer on openHedge (creates dust risk).
# Only for one-off operator orders where dust exposure is knowingly accepted.
BLUEFIN_ALLOW_DUST_RISK_OPEN=

# =============================================================================
# DEPLOY WATCHDOG (piggybacks on hourly sui-hedge-reconcile)
# =============================================================================
# Repo used to check origin/main HEAD via GitHub API. Only set if the
# repo owner/name differs from the default (ZkVanguard/ZkVanguard).
DEPLOY_WATCHDOG_REPO=

# =============================================================================
# INTERNAL URLS (used by crons and health-monitor for internal API calls)
# =============================================================================
# PROD_URL is health-monitor's target; NEXT_PUBLIC_URL is used by
# auto-rebalance cron to hit its own API surface
PROD_URL=https://www.zkward.com
NEXT_PUBLIC_URL=https://www.zkward.com
NEXT_PUBLIC_CHAIN_ID=25
NEXT_PUBLIC_DELPHI_API=https://api.delphi.markets

